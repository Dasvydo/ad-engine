# ad-engine environment. Copy to .env and fill in. .env is gitignored.
# NO REAL VALUES EVER GO IN THIS FILE. It is committed.

# --- Meta ------------------------------------------------------------------
# From Events Manager. Public identifier, not a secret, but it does not exist
# yet. See campaigns/pixel-install.md.
META_PIXEL_ID=

# Ads Manager > account overview. With or without the act_ prefix.
META_AD_ACCOUNT_ID=

# System user token with ads_read, from Business Settings > System Users.
# THIS IS A SECRET. Never commit it, never paste it into a doc, never log it.
# Without it report/pull_ad_stats.py refuses to run live and tells you to use
# --dry-run instead.
META_ACCESS_TOKEN=

# --- Ledger (Batch B) ------------------------------------------------------
# The ledger is Supabase project oqpeebtwtikdzorgouxd (confirmed by Dovy,
# 2026-09-06). That ref is a public identifier, not a secret. This repo never
# connects to it directly: report/pull_ad_stats.py imports campaign_db.py from
# the campaign-ledger repo, and campaign_db.py owns the connection and its
# credentials. Point PYTHONPATH at that repo, or leave this unset and rows fall
# back to report/out/ad_stats.jsonl with a warning.
# PYTHONPATH=/path/to/campaign-ledger
